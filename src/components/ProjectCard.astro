---
import type { Project } from '@/types';
import { imageUrl } from '@/lib/sanity/image';
interface Props {
  project: Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const cover = imageUrl(project.coverImage, 1200, 900);
---

<article
  class:list={['project-card', `project-card--${index % 3}`]}
  data-category={project.category?.slug || 'todos'}
>
  <a href={`/portfolio/${project.slug}`}
    ><div class="project-media">
      {
        cover ? (
          <img
            src={cover}
            alt={project.coverImage?.alt || `Capa do projeto ${project.title}`}
            width="1200"
            height="900"
            loading="lazy"
          />
        ) : (
          <div class="project-placeholder">
            <>
              <span>PROJETO</span>
              <strong>{String(index + 1).padStart(2, '0')}</strong>
            </>
          </div>
        )
      }<span class="project-arrow">↗</span>
    </div><div class="project-meta">
      <div>
        <span>{project.client || 'Projeto Yoop'}</span><h3>{project.title}</h3>
      </div><p>{project.category?.name || 'Case'}</p>
    </div></a>
</article>
