---
import { Image } from 'astro:assets';
import logo from '@/assets/yoop/logo.png';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span
  class:list={['brand', { 'brand--compact': compact }]}
  aria-label="Agência Yoop"
>
  <Image
    src={logo}
    alt=""
    width={compact ? 84 : 116}
    quality={85}
    format="webp"
    loading="eager"
  />
</span>

<style>
  .brand {
    display: inline-flex;
    width: 7.25rem;
    height: 3.3rem;
    align-items: center;
  }
  .brand--compact {
    width: 5.25rem;
    height: 2.6rem;
  }
  .brand :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
