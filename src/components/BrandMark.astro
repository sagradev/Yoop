---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class="brand" aria-label="Agência Yoop"
  ><span class="brand-kicker">AGÊNCIA</span><strong>Yoo<span>p</span></strong>{
    !compact && <i>↗</i>
  }</span
>
<style>
  .brand {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 0.45rem;
    line-height: 0.75;
    color: var(--ink);
  }
  .brand-kicker {
    grid-column: 1;
    font-size: 0.48rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }
  .brand strong {
    grid-column: 1;
    font: 800 1.55rem/1 var(--font-display);
    letter-spacing: -0.08em;
  }
  .brand strong span {
    color: var(--orange);
  }
  .brand i {
    grid-column: 2;
    grid-row: 1/3;
    color: var(--lime);
    font: normal 1.4rem/1 sans-serif;
  }
</style>
